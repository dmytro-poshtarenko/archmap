{
  "name": "archmap",
  "version": "0.1.0",
  "description": "Recovers inter-service links of multi-repository JS/TS systems and renders them as C4 (LikeC4) diagrams",
  "license": "MIT",
  "type": "module",
  "bin": {
    "archmap": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "archmap": "tsx src/cli/index.ts",
    "licence-check": "tsx src/cli/index.ts licence-check",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:system": "ARCHMAP_SYSTEM=1 vitest run test/system"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "commander": "15.0.0",
    "hcl2-json-parser": "1.0.1",
    "js-yaml": "5.4.3",
    "picomatch": "4.0.7",
    "tinyglobby": "0.2.17",
    "ts-morph": "28.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/picomatch": "4.0.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
